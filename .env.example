# Required - Roblox API Configuration
ROBLOX_UNIVERSE_ID=your_universe_id_here
ROBLOX_API_KEY=your_roblox_api_key_here
SERVER_AUTH_SECRET=your_auth_secret_here

# Optional - Roblox Configuration
ROBLOX_TOPIC=GlobalMatchmaking

# Optional - Redis Configuration
REDIS_URL=redis://127.0.0.1:6379
REDIS_POOL_MAX_SIZE=16
REDIS_POOL_MIN_IDLE=4

# Optional - Matchmaking Configuration
MIN_PLAYERS_PER_MATCH=1
MAX_PLAYERS_PER_MATCH=12
MAX_PARTY_SIZE=4
INITIAL_RATING_RANGE=100.0
RATING_EXPANSION_PER_LEVEL=50.0
MAX_RATING_RANGE=500.0
MIN_RATING=0.0
MAX_RATING=10000.0
RATING_BUCKET_SIZE=100.0

# Optional - Timing Configuration
MATCHMAKER_TICK_RATE_SECONDS=5
SEARCH_EXPANSION_INTERVAL_SECONDS=30
TICKET_TTL_SECONDS=300
HTTP_TIMEOUT_SECONDS=30

# Optional - Rate Limiting
SUBMIT_RATE_LIMIT=1000
REGIONAL_RATE_LIMIT=500

# Optional - Region Configuration
DEFAULT_REGION=NorthAmerica

# Optional - Debug Mode
DEBUG=false
